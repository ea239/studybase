// StudyBase — Phase 1 (MVP) schema
// Scope: PDF upload -> text extraction -> AI-extracted knowledge points & questions
// with source file + page tracking. Subject/Chapter are manually assigned for now.
// A Subject is a single course (e.g. "ECE 356") — there is no separate
// "course" grouping layer above it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MaterialStatus {
  PENDING // uploaded, waiting to be processed
  PROCESSING // text extraction / AI extraction running
  DONE
  NEEDS_REVIEW // AI finished but low confidence, needs human check
  FAILED
}

enum MaterialType {
  PDF
  HTML
  // PowerPoint and Word, converted to PDF before parsing. Courses post
  // outlines and lab sheets in these formats, and a dropped outline takes the
  // course's whole schedule with it.
  OFFICE
  // IMAGE planned for a later phase
}

enum MaterialCategory {
  NOTES // lecture slides, textbook excerpts, notes -> knowledge points & questions
  OVERVIEW // syllabus, grading breakdown, schedule -> course structure info
  LAB // lab manual/assignment sheet -> lab number, due date, deliverables, grading
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  chapters  Chapter[]
  materials Material[]
  learnCourses LearnCourse[]
  events    CourseEvent[]

  /// The course's administrative facts at a glance, written from its outline.
  /// `factsStatus` is stored rather than inferred so the panel can say it is
  /// working: without it, "no facts yet" and "being written right now" look
  /// identical to anyone waiting.
  facts            String?
  factsStatus      SubjectFactsStatus @default(NONE)
  factsGeneratedAt DateTime?
}

enum SubjectFactsStatus {
  NONE // no outline-type material to read yet
  GENERATING
  READY
  EMPTY // read the outline, found nothing worth showing
}

model Chapter {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  overview            String? // AI-generated study explanation, manually (re)generated from Settings
  overviewGeneratedAt DateTime?
  /// Set while notes are being written, cleared when they are.
  ///
  /// Stored rather than held in the page's state: the work continues on the
  /// server after the reader navigates away, and without this, coming back
  /// showed "not generated yet" for something actively being generated. A
  /// timestamp rather than a flag so a run killed mid-flight can be told from
  /// one still going — see GENERATION_TIMEOUT_MS.
  overviewStartedAt   DateTime?

  materials       Material[]
  knowledgePoints KnowledgePoint[]
  questions       Question[]

  @@unique([subjectId, name])
}

// One uploaded source file. The original file is never overwritten or deleted
// by re-processing — only the derived content (pages/knowledge points/questions) is.
model Material {
  id           String         @id @default(cuid())
  filename     String
  storagePath  String // path on disk (phase 1: local filesystem)
  fileType     MaterialType     @default(PDF)
  category     MaterialCategory @default(NOTES)
  status       MaterialStatus   @default(PENDING)
  errorMessage String?

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  summary   String? // AI-generated summary of the whole document

  // Set when the file came from a LEARN sync rather than a manual upload.
  // learnTopicId is LEARN's own topic id, and is what makes a re-sync
  // idempotent; learnUpdatedAt is LEARN's last-modified stamp, so a file the
  // instructor revises gets re-downloaded while unchanged ones are skipped.
  learnTopicId   String?   @unique
  learnUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages           MaterialPage[]
  knowledgePoints KnowledgePoint[]
  questions       Question[]
  events          CourseEvent[]
}

// Raw extracted text per page, kept verbatim as ground truth for citations.
model MaterialPage {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  pageNumber Int
  rawText    String

  @@unique([materialId, pageNumber])
}

// AI-extracted knowledge point (definition, formula, key concept, worked example).
// Always traceable back to the source material + page.
model KnowledgePoint {
  id         String  @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  chapterId  String?
  chapter    Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  title       String
  content     String // explanation / formula / definition text
  sourcePage  Int?
  tags        String? // comma-separated for phase 1 (no separate tag table yet)
  isAiGenerated Boolean @default(true)
  confidence  Float?  // 0-1, AI's confidence in this extraction; null if human-authored

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

// A question extracted from (or written for) a material. Kept independent
// so it can be reused in practice sets regardless of its source document.
model Question {
  id         String   @id @default(cuid())
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  chapterId  String?
  chapter    Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  stem        String // question text
  options     String? // JSON-encoded array for multiple choice; null for free-response
  answer      String
  explanation String?
  difficulty  QuestionDifficulty @default(MEDIUM)
  sourcePage  Int?
  isAiGenerated Boolean @default(true)
  confidence  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Everyone who has signed in with Google. Access is not granted by having a
// valid Google account — the owner has to approve each one, so a new sign-in
// lands here as pending and can see nothing until then.
model AppUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  picture   String?
  isOwner   Boolean  @default(false)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
}

// A saved ask-AI thread. Kept server-side rather than in the browser so the
// same conversation is there when the app is opened from another device.
model Conversation {
  id        String   @id @default(cuid())
  title     String
  subjectId String?
  chapterId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ConversationMessage[]

  @@index([subjectId, updatedAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  // The passage the question was asked about, kept so a reopened thread still
  // shows what was being discussed.
  quote          String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// Server-side app settings (single-user, phase 1). Holds the active AI
// provider configuration. Not encrypted at rest — fine for a personal/local
// deployment, must change before this becomes multi-user.
model Setting {
  key   String @id
  value String
}

// A dated item pulled out of a course's own documents — a lab due date, an
// assignment deadline, an exam window.
//
// Course documents state dates with wildly varying certainty: "September 25,
// 11:59pm" is something to put in a calendar cell, while "October 26-30th" for
// a midterm is a window the registrar has not fixed yet. Keeping that
// distinction is the point of `precision`: only EXACT is placed on a day.
model CourseEvent {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // The document this came from, so a re-parse can replace exactly its own
  // events and the calendar can link back to the source.
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  sourcePage Int?

  title String
  kind  CourseEventKind @default(OTHER)

  precision CourseEventPrecision @default(UNKNOWN)
  startsAt  DateTime? // set for EXACT and RANGE
  endsAt    DateTime? // set for RANGE only
  /// Verbatim wording when the source gives no usable date ("期末考试周").
  approxLabel String?

  /// Ticked off by hand. Completed work stays listed, just out of the way.
  completedAt DateTime?

  /// AI-written brief for this piece of work: what it asks for, how it is
  /// marked, what to hand in. Assembled from the assignment's own document
  /// plus the guidelines and outline that qualify it, which is why it is
  /// stored rather than re-derived on every view.
  brief            String?
  briefGeneratedAt DateTime?
  /// Set while the brief is being written; see Chapter.overviewStartedAt.
  briefStartedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([subjectId, startsAt])
}

enum CourseEventKind {
  LAB
  ASSIGNMENT
  EXAM
  OTHER
}

enum CourseEventPrecision {
  EXACT // a specific day — goes on the calendar
  RANGE // a window, e.g. an exam period
  UNKNOWN // named but undated
}

// A course on LEARN (D2L Brightspace), mirrored locally so the owner can pick
// which ones to sync and which local Subject each one feeds. orgUnitId is
// LEARN's identifier for the course offering and is stable across terms.
model LearnCourse {
  id        String @id @default(cuid())
  orgUnitId String @unique
  name      String
  code      String?

  // Nothing is downloaded until the owner enables the course and points it at
  // a Subject — an un-mapped course would dump materials into "未分类".
  enabled   Boolean @default(false)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  lastSyncedAt DateTime?
  lastResult   String? // short human-readable outcome of the last sync attempt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
